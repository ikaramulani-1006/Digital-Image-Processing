{
   "source": [
    "from PIL import Image\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "img = Image.open(r\"C:\\Users\\Student\\Desktop\\1012411204_DAA\\beautiful-cats-y4upwj5zz45novpx.jpg\").convert(\"L\")\n",
    "img = np.array(img)\n",
    "\n",
    "h, w = img.shape\n",
    "image = img.tolist()\n",
    "\n",
    "def convolution(img, filter):\n",
    "    h, w = img.shape\n",
    "    fh, fw = filter.shape\n",
    "    output = np.zeros((h, w))\n",
    "    for i in range(1, h-1):\n",
    "        for j in range(1, w-1):\n",
    "            s = 0\n",
    "            for m in range(fh):\n",
    "                for n in range(fw):\n",
    "                    s += img[i+m-1][j+n-1] * filter[m][n]\n",
    "            output[i][j] = s\n",
    "    return output\n",
    "\n",
    "def Robert_filter(img):\n",
    "    robert = np.array([[-1, 0],[ 0, 1]])\n",
    "    r = convolution(img, robert)\n",
    "    return r\n",
    "\n",
    "def sobel_filter(img):\n",
    "    sobel = np.array([[-1, -2, -1],[ 0,  0,  0],[ 1,  2,  1]])\n",
    "    s = convolution(img, sobel)\n",
    "    return s\n",
    "\n",
    "def Prewitt_filter(img):\n",
    "    prewitt = np.array([[-1, -1, -1],[ 0,  0,  0], [ 1,  1,  1]])\n",
    "    p = convolution(img, prewitt)\n",
    "    return p\n",
    "\n",
    "def Mean_filter(img):\n",
    "    mean = np.array([[1/9, 1/9, 1/9],[1/9, 1/9, 1/9],[1/9, 1/9, 1/9]])\n",
    "    m = convolution(img, mean)\n",
    "    return m\n",
    "\n",
    "def Gaussian_Filter(img):\n",
    "    gaussian = np.array([[1/16, 2/16, 1/16],[2/16, 4/16, 2/16],[1/16, 2/16, 1/16]])\n",
    "    g = convolution(img, gaussian)\n",
    "    return g\n",
    "\n",
    "def Median_filter(img):\n",
    "    h, w = img.shape\n",
    "    med = np.zeros((h, w))\n",
    "    for i in range(1, h-1):\n",
    "        for j in range(1, w-1):\n",
    "            values = []\n",
    "            for m in range(3):\n",
    "                for n in range(3):\n",
    "                    values.append(img[i+m-1][j+n-1])\n",
    "            values.sort()\n",
    "            med[i][j] = values[4]\n",
    "    return med\n",
    "\n",
    "def Max_filter(img):\n",
    "    h, w = img.shape\n",
    "    max_Filter = np.zeros((h, w))\n",
    "    for i in range(1, h-1):\n",
    "        for j in range(1, w-1):\n",
    "            values = []\n",
    "            for m in range(3):\n",
    "                for n in range(3):\n",
    "                    values.append(img[i+m-1][j+n-1])\n",
    "            max_Filter[i][j] = max(values)\n",
    "    return max_Filter\n",
    "\n",
    "def Min_filter(img):\n",
    "    h, w = img.shape\n",
    "    Min_Filter = np.zeros((h, w))\n",
    "    for i in range(1, h-1):\n",
    "        for j in range(1, w-1):\n",
    "            values = []\n",
    "            for m in range(3):\n",
    "                for n in range(3):\n",
    "                    values.append(img[i+m-1][j+n-1])\n",
    "            Min_Filter[i][j] = min(values)\n",
    "    return Min_Filter\n",
    "\n",
    "while True:\n",
    "    print(\"Filtering Technique\")\n",
    "    print(\"1. Display Original Image\")\n",
    "    print(\"2. Robert Filter\")\n",
    "    print(\"3. Sobel Filter\")\n",
    "    print(\"4. Prewitt Filter\")\n",
    "    print(\"5. Mean Filter\")\n",
    "    print(\"6. Gaussian Filter\")\n",
    "    print(\"7. Median Filter\")\n",
    "    print(\"8. Max Filter\")\n",
    "    print(\"9. Min Filter\")\n",
    "    print(\"0. Exit\")\n",
    "    choice = int(input(\"Enter your choice: \"))\n",
    "    if choice == 1:\n",
    "        print(\"Original Image:\")\n",
    "        plt.imshow(img, cmap='gray')\n",
    "        plt.title(\"Original Image\")\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "\n",
    "    elif choice == 2:\n",
    "        result = Robert_filter(img)\n",
    "        print(\"Robert Filter Output:\")\n",
    "        plt.imshow(result, cmap='gray')\n",
    "        plt.title(\"Robert Filter\")\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "        \n",
    "    elif choice == 3:\n",
    "        result = sobel_filter(img)\n",
    "        print(\"Sobel Filter Output:\")\n",
    "        plt.imshow(result, cmap='gray')\n",
    "        plt.title(\"Sobel Filter\")\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "\n",
    "    elif choice == 4:\n",
    "        result = Prewitt_filter(img)\n",
    "        print(\"Prewitt Filter Output:\")\n",
    "        plt.imshow(result, cmap='gray')\n",
    "        plt.title(\"Prewitt Filter\")\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "\n",
    "    elif choice == 5:\n",
    "        result = Mean_filter(img)\n",
    "        print(\"Mean Filter Output:\")\n",
    "        plt.imshow(result, cmap='gray')\n",
    "        plt.title(\"Mean Filter\")\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "\n",
    "    elif choice == 6:\n",
    "        result = Gaussian_Filter(img)\n",
    "        print(\"Gaussian Filter Output:\")\n",
    "        plt.imshow(result, cmap='gray')\n",
    "        plt.title(\"Gaussian Filter\")\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "\n",
    "    elif choice == 7:\n",
    "        result = Median_filter(img)\n",
    "        print(\"Median Filter Output:\")\n",
    "        plt.imshow(result, cmap='gray')\n",
    "        plt.title(\"Median Filter\")\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "\n",
    "    elif choice == 8:\n",
    "        result = Max_filter(img)\n",
    "        print(\"Max Filter Output:\")\n",
    "        plt.imshow(result, cmap='gray')\n",
    "        plt.title(\"Max Filter\")\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "\n",
    "    elif choice == 9:\n",
    "        result = Min_filter(img)\n",
    "        print(\"Min Filter Output:\")\n",
    "        plt.imshow(result, cmap='gray')\n",
    "        plt.title(\"Min Filter\")\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "\n",
    "    elif choice == 0:\n",
    "        print(\"Program Ended...Exiting the program...^_^\")\n",
    "        break\n",
    "    else:\n",
    "        print(\"Invalid Choice!!!! Please enter a number between 1 and 7.\")"
   ]
